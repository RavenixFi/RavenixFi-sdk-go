# virexonfi Go SDK — Environment Variables
# Copy this to .env and fill in your values.

# Required: Your virexonfi API key (starts with sk_liv_ or sk_test_)
virexonfi_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override API base URL (default: https://api.virexonfi.com)
# virexonfi_BASE_URL=https://api.virexonfi.com

# Optional: Override WebSocket URL (default: wss://ws.virexonfi.com)
# virexonfi_WS_URL=wss://ws.virexonfi.com

# Optional: Request timeout in milliseconds (default: 30000)
# virexonfi_TIMEOUT=30000
